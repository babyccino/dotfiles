// Zed settings
//
// For information on how to configure Zed, see the Zed // documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.

{
  "file_scan_exclusions": ["**/node_modules"],
  "cli_default_open_behavior": "new_window",
  "vim": {
    "cursor_shape": {
      "visual": "hollow",
    },
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "git_panel": {
    "dock": "left",
    "button": false,
  },
  "file_finder": {},
  "diagnostics": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "status_bar": {
    "active_encoding_button": "non_utf8",
    "cursor_position_button": true,
    "active_language_button": false,
  },
  "project_panel": {
    "dock": "left",
    "button": false,
  },
  "auto_update": true,
  "hard_tabs": false,
  "show_edit_predictions": true,
  "gutter": {
    "min_line_number_digits": 1,
    "line_numbers": true,
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
  },
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enabled": false,
  },
  "title_bar": {
    "show_branch_name": true,
    "show_user_menu": true,
    "show_user_picture": true,
    "show_menus": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true,
  },
  "toolbar": {
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "use_system_path_prompts": false,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "button": false,
  },
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
  },
  "git": {
    "git_gutter": "tracked_files",
  },
  "tabs": {
    "show_close_button": "hidden",
    "close_position": "right",
    "file_icons": false,
    "git_status": true,
  },
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [".env"],
  },
  "edit_predictions_disabled_in": ["comment", "string"],
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
  },
  "vim_mode": true,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Fleet Dark"
  },
  "relative_line_numbers": "enabled",
  "ui_font_size": 14,
  "buffer_font_size": 13.0,
  "tab_size": 2,
  "terminal": {
    "button": false,
    "font_family": "Menlo",
    "font_size": 13,
    "dock": "right",
  },
  "format_on_save": "on",
  "languages": {
    "Plain Text": {
      "show_edit_predictions": false,
    },
    "Rust": {
      "tab_size": 4,
    },
    "CSharp": {
      "tab_size": 4,
      "language_servers": ["omnisharp", "!roslyn", "..."],
    },
    "TypeScript": {
      "language_servers": ["vtsls"],
    },
  },
  "buffer_font_family": "Hack FC Ligatured",
  "buffer_font_features": {
    "calt": true,
  },
  "ui_font_family": "SF Pro",
  "lsp": {
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
  },
}
